    # --- Actions d'envoi & Commandes Utiles ---
    def envoyer(self):
        if not hasattr(self, "entree") or not self.entree.winfo_exists(): return
        texte = self.entree.get().strip()
        if not texte: return
        self.entree.delete(0, tk.END)

        # Traitement des commandes utiles (/help, /clear, /shrug, /tableflip)
        if texte == "/clear":
            self.zone_texte.config(state="normal")
            self.zone_texte.delete("1.0", tk.END)
            self.zone_texte.config(state="disabled")
            return
        elif texte == "/help":
            self.afficher_systeme("Commandes disponibles : /clear (effacer l'écran), /shrug, /tableflip, /help")
            return
        elif texte == "/shrug":
            texte = r"¯\_(ツ)_/¯"
        elif texte == "/tableflip":
            texte = "(╯°□°)╯︵ ┻━┻"

        if len(texte) > 500: texte = texte[:500]

        # 1. Affichage Local
        try:
            self.afficher_message(self.pseudo, texte)
        except Exception as e:
            log.warning(f"Affichage local échec: {e}")

        # 2. Diffusion Réseau
        try:
            data = make_msg("msg", pseudo=self.pseudo, text=texte, salon=self.salon_courant)
            if self.mode == "host":
                self._diffuser(data)
            elif self.mode == "client" and self.sock:
                self.sock.sendall(data)
        except OSError:
            self.afficher_erreur("Erreur réseau : message non transmis.")

        # 3. Gain d'XP & Sons
        try:
            self._gagner_xp(2, coins=1, msgs=1)
            son_envoi(self.compte)
        except Exception: pass

    def afficher_message(self, pseudo, texte):
        if not hasattr(self, "zone_texte"): return
        self.zone_texte.config(state="normal")
        col = couleur_hex(self.compte["equip"]["couleur"]) if pseudo == self.pseudo else C_BLUE
        tag_pseudo = f"p_{pseudo}_{time.time()}"
        self.zone_texte.tag_config(tag_pseudo, foreground=col, font=(FONT, 10, "bold"))
        self.zone_texte.insert(tk.END, f"[{time.strftime('%H:%M')}] ")
        self.zone_texte.insert(tk.END, f"{pseudo}: ", tag_pseudo)
        self.zone_texte.insert(tk.END, f"{texte}\n")
        self.zone_texte.see(tk.END)
        self.zone_texte.config(state="disabled")

    def afficher_systeme(self, txt):
        if not hasattr(self, "zone_texte"): return
        self.zone_texte.config(state="normal")
        self.zone_texte.insert(tk.END, f"ℹ️ {txt}\n")
        self.zone_texte.see(tk.END)
        self.zone_texte.config(state="disabled")

    def afficher_erreur(self, txt):
        if not hasattr(self, "zone_texte"): return
        self.zone_texte.config(state="normal")
        self.zone_texte.insert(tk.END, f"⚠️ Erreur: {txt}\n")
        self.zone_texte.see(tk.END)
        self.zone_texte.config(state="disabled")

    def _gagner_xp(self, xp, coins=0, msgs=0):
        if not self.compte: return
        self.compte["xp"] += xp
        self.compte["coins"] += coins
        self.compte["msgs"] += msgs
        self.gc.sauver()

    def _maj_profil(self, prof):
        if prof.get("pseudo") in self.profils:
            self.profils[prof["pseudo"]].update(prof)

    # --- Boutique ---
    def ouvrir_boutique(self):
        win = tk.Toplevel(self.root)
        win.title("🛍️ Boutique LANChat")
        win.geometry("450x500")
        win.configure(bg=C_BG)

        tk.Label(win, text=f"Solde : {self.compte['coins']} 🪙", font=(FONT, 12, "bold"), fg=C_YELLOW, bg=C_BG).pack(pady=10)

        nbook = ttk.Notebook(win)
        nbook.pack(fill="both", expand=True, padx=10, pady=5)

        # Onglet Couleurs
        f_coul = tk.Frame(nbook, bg=C_BG)
        nbook.add(f_coul, text="Couleurs")
        for cid, item in COULEURS.items():
            if cid == "defaut": continue
            f = tk.Frame(f_coul, bg=C_SURF2, pady=3)
            f.pack(fill="x", padx=5, pady=2)
            tk.Label(f, text=item["nom"], fg=item["hex"], bg=C_SURF2, font=(FONT, 10, "bold")).pack(side="left", padx=5)
            b = tk.Button(f, text=f"Acheter ({item['prix']} 🪙)",
                          command=lambda c=cid, p=item['prix']: self._acheter_item("couleurs", c, p, win))
            self._btn_styler(b, C_GREEN)
            b.pack(side="right", padx=5)

    def _acheter_item(self, categorie, item_id, prix, win):
        if self.compte["coins"] < prix:
            messagebox.showwarning("Boutique", "Pas assez de pièces !")
            return
        if item_id in self.compte["possede"].get(categorie, []):
            messagebox.showinfo("Boutique", "Déjà possédé !")
            return
        self.compte["coins"] -= prix
        self.compte["possede"].setdefault(categorie, []).append(item_id)
        self.gc.sauver()
        messagebox.showinfo("Boutique", "Achat effectué avec succès !")
        win.destroy()

