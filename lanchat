# --- Audio Session ---
class AudioSession:
    def __init__(self):
        self.actif = False
        self.pa = None
        self.in_stream = None
        self.out_stream = None
        self.sock = None
        self.peer = None
        self.mute = False

    def allouer(self):
        if not AUDIO_OK or self.actif: return
        try:
            self.pa = pyaudio.PyAudio()
            self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            self.sock.bind(("0.0.0.0", 0))
            self.actif = True
        except Exception as e:
            log.warning(f"AudioSession Error: {e}")

    def mon_port(self):
        return self.sock.getsockname()[1] if self.sock else None

    def basculer_mute(self):
        self.mute = not self.mute
        return self.mute

    def arreter(self):
        self.actif = False
        for s in (self.in_stream, self.out_stream):
            try:
                if s: s.stop_stream(); s.close()
            except Exception: pass
        try:
            if self.pa: self.pa.terminate()
        except Exception: pass
        try:
            if self.sock: self.sock.close()
        except Exception: pass
        self.in_stream = self.out_stream = self.sock = self.pa = None
        self.peer = None

