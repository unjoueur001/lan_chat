def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(r, g, b):
    return f"#{r:02x}{g:02x}{b:02x}"

def _gradient_hex(c1, c2, steps=20):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    out = []
    for i in range(steps):
        t = i / max(1, steps-1)
        te = 0.5 - 0.5 * (1 - t) ** 2
        out.append(rgb_to_hex(int(r1+(r2-r1)*te), int(g1+(g2-g1)*te), int(b1+(b2-b1)*te)))
    return out

def _multi_gradient_hex(colors, steps=60):
    if len(colors) < 2: return colors * steps
    out = []
    seg = max(2, steps // max(1, len(colors)-1))
    for i in range(len(colors)-1):
        s = seg if i < len(colors)-2 else seg + steps - seg*(len(colors)-1)
        out.extend(_gradient_hex(colors[i], colors[i+1], s))
    return out[:steps]

# --- Gestionnaire de Comptes Locaux ---
class GestionnaireCompte:
    def __init__(self, fichier=COMPTES_FILE):
        self.fichier = fichier
        self.comptes = self.charger()

    def charger(self):
        if os.path.exists(self.fichier):
            try:
                with open(self.fichier, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception: return {}
        return {}

    def sauver(self):
        try:
            with open(self.fichier, "w", encoding="utf-8") as f:
                json.dump(self.comptes, f, ensure_ascii=False, indent=2)
        except Exception as e: log.warning(f"Sauvegarde compte échec: {e}")

    def authentifier(self, pseudo, mdp):
        if pseudo in self.comptes:
            h = hashlib.sha256(mdp.encode()).hexdigest()
            if self.comptes[pseudo].get("mdp") == h:
                return self.comptes[pseudo]
        return None

    def creer(self, pseudo, mdp):
        if pseudo in self.comptes: return None
        h = hashlib.sha256(mdp.encode()).hexdigest()
        compte = {
            "pseudo": pseudo,
            "mdp": h,
            "xp": 0,
            "coins": 100,
            "msgs": 0,
            "appels": 0,
            "avatar_emoji": "🧑",
            "bio": "Salut ! J'utilise LANChat.",
            "liens": [],
            "amis": [],
            "equip": {"couleur": COULEURS_DEFAUT, "badge": BADGE_DEFAUT, "titre": TITRE_DEFAUT, "cadre": CADRE_DEFAUT, "fond": "defaut"},
            "possede": {"couleurs": [COULEURS_DEFAUT], "badges": [BADGE_DEFAUT], "titres": [TITRE_DEFAUT], "cadres": [CADRE_DEFAUT]}
        }
        self.comptes[pseudo] = compte
        self.sauver()
        return compte

