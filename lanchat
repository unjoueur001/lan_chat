    # --- Hébergement & Connexion ---
    def demarrer_hote(self):
        self.mode = "host"
        self.salons = list(SALONS_DEFAUT)
        self.salon_courant = "général"
        threading.Thread(target=self._servir_tcp, daemon=True).start()
        threading.Thread(target=self._servir_udp, daemon=True).start()
        self._construire_interface_chat()
        self.afficher_systeme(f"Serveur démarré sur {local_ip()}:{TCP_PORT}")

    def _servir_tcp(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("0.0.0.0", TCP_PORT))
            s.listen(10)
            self.tcp_server = s
            while self.running:
                conn, addr = s.accept()
                threading.Thread(target=self._gerer_client, args=(conn, addr), daemon=True).start()
        except Exception as e:
            log.warning(f"TCP Server Error: {e}")

    def _gerer_client(self, conn, addr):
        pseudo_client = None
        def on_line(m):
            nonlocal pseudo_client
            t = m.get("type")
            if t == "hello":
                pseudo_client = m.get("pseudo", "Anonyme")
                with self.clients_lock:
                    self.clients.append(conn)
                    self.pseudo_to_sock[pseudo_client] = conn
                self.nb_connectes += 1
                self.ui_queue.put(("sys", f"🟢 {pseudo_client} a rejoint le réseau !"))
                conn.sendall(make_msg("salons_init", salons=self.salons))
            elif t == "msg":
                txt = m.get("text", "")
                ps = m.get("pseudo", pseudo_client)
                self.ui_queue.put(("msg", ps, txt))
                self._diffuser(make_msg("msg", pseudo=ps, text=txt), except_=conn)
            elif t == "salon_cree":
                nom, typ, desc = m.get("nom"), m.get("type_salon"), m.get("desc")
                self.salons.append({"nom": nom, "type": typ, "desc": desc})
                self.ui_queue.put(("salon_cree", nom, typ, desc))
                self._diffuser(make_msg("salon_cree", nom=nom, type_salon=typ, desc=desc), except_=conn)

        recv_lines(conn, on_line)
        with self.clients_lock:
            if conn in self.clients: self.clients.remove(conn)
            if pseudo_client in self.pseudo_to_sock: del self.pseudo_to_sock[pseudo_client]
        if pseudo_client:
            self.nb_connectes = max(0, self.nb_connectes - 1)
            self.ui_queue.put(("sys", f"🔴 {pseudo_client} s'est déconnecté."))

    def _diffuser(self, data, except_=None):
        with self.clients_lock:
            cibles = [c for c in self.clients if c is not except_]
        for c in cibles:
            try: c.sendall(data)
            except OSError: pass

    def _servir_udp(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            s.bind(("0.0.0.0", UDP_PORT))
            self.udp_sock = s
        except OSError: return
        annonce = make_udp("announce", port=TCP_PORT, name=APP_NAME, host_pseudo=self.pseudo, version=VERSION)
        while self.running:
            try:
                s.settimeout(1.0)
                data, addr = s.recvfrom(4096)
                msg = parse_udp(data)
                if msg and msg.get("type") == "discover":
                    s.sendto(annonce, addr)
            except socket.timeout:
                try: s.sendto(annonce, ("255.255.255.255", UDP_PORT))
                except OSError: pass
            except OSError: break

    # --- Recherche Client ---
    def demarrer_rejoindre(self):
        self.mode = "client"
        self._ecran_chargement("Recherche de salons sur le réseau LAN...")
        threading.Thread(target=self._scan_reseau, daemon=True).start()

    def _scan_reseau(self):
        trouve = {}
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            s.bind(("0.0.0.0", UDP_PORT))
            s.sendto(make_udp("discover"), ("255.255.255.255", UDP_PORT))
        except OSError as e:
            self.ui_queue.put(("connect_fail", f"Erreur scan : {e}"))
            return
        echeance = time.time() + SCAN_TIME
        while time.time() < echeance:
            try:
                s.settimeout(0.4)
                data, addr = s.recvfrom(4096)
                msg = parse_udp(data)
                if msg and msg.get("type") == "announce":
                    cle = (addr[0], int(msg.get("port", TCP_PORT)))
                    trouve[cle] = (msg.get("name", "Salon LAN"), msg.get("host_pseudo", "?"), msg.get("version", ""))
                    self.ui_queue.put(("scan_progress", len(trouve)))
            except socket.timeout: continue
            except OSError: break
        try: s.close()
        except OSError: pass
        self.ui_queue.put(("discovered", [(ip, port, nom, hp, v) for (ip, port), (nom, hp, v) in trouve.items()]))

    def _ecran_chargement(self, txt):
        self._reset_frame()
        f = self.frame
        self.lbl_chargement = tk.Label(f, text=txt, font=(FONT, 12), fg=C_TEXT, bg=C_BG)
        self.lbl_chargement.pack(pady=40)
        self.lbl_compteur = tk.Label(f, text="0 salon trouvé", font=(FONT, 10), fg=C_GREEN, bg=C_BG)
        self.lbl_compteur.pack(pady=10)
        b = tk.Button(f, text="Annuler", command=self._ecran_demarrage)
        self._btn_styler(b, C_INP, C_TEXT); b.pack()

    def _maj_chargement(self, n):
        if hasattr(self, "lbl_compteur"):
            self.lbl_compteur.config(text=f"{n} salon(s) trouvé(s)")

    def _fin_scan(self, serveurs):
        if not serveurs:
            messagebox.showinfo(APP_NAME, "Aucun salon trouvé. Vérifie ton réseau local.")
            self._ecran_demarrage()
            return
        self._ecran_choix_serveur(serveurs)

    def _ecran_choix_serveur(self, serveurs):
        self._reset_frame()
        f = self.frame
        self._titre_anime(f, "Salons LAN Découverts", C_GREEN, 16)
        liste = tk.Listbox(f, font=(FONT, 11), bg=C_SURF2, fg=C_TEXT, selectbackground=C_BLUE)
        for ip, port, nom, hp, v in serveurs:
            liste.insert(tk.END, f" {nom} ({hp}) — {ip}:{port} [{v}]")
        liste.pack(padx=30, pady=10, fill="both", expand=True)
        liste.selection_set(0)

        def connecter():
            sel = liste.curselection()
            if not sel: return
            ip, port, nom, hp, v = serveurs[sel[0]]
            self._connecter_a(ip, port)

        b = tk.Button(f, text="Se connecter", command=connecter)
        self._btn_styler(b, C_GREEN); b.pack(pady=10)

    def rejoindre_ip_manuel(self):
        ip = simpledialog.askstring("Connexion IP", "Adresse IP de l'hôte :", parent=self.root)
        if ip: self._connecter_a(ip.strip(), TCP_PORT)

    def _connecter_a(self, ip, port):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(5.0)
            s.connect((ip, port))
            s.settimeout(None)
            self.sock = s
            s.sendall(make_msg("hello", pseudo=self.pseudo))
            threading.Thread(target=self._boucle_reception, daemon=True).start()
            self._on_connecte()
        except OSError as e:
            messagebox.showerror(APP_NAME, f"Impossible de se connecter : {e}")
            self._ecran_demarrage()

    def _boucle_reception(self):
        def on_line(m):
            t = m.get("type")
            if t == "msg":
                self.ui_queue.put(("msg", m.get("pseudo", "?"), m.get("text", "")))
            elif t == "sys":
                self.ui_queue.put(("sys", m.get("text", "")))
            elif t == "salons_init":
                self.ui_queue.put(("salons_init", m.get("salons", [])))
            elif t == "salon_cree":
                self.ui_queue.put(("salon_cree", m.get("nom", ""), m.get("type_salon", "texte"), m.get("desc", "")))
        recv_lines(self.sock, on_line)
        self.ui_queue.put(("err", "Connexion perdue avec le serveur."))

    def _on_connecte(self):
        self._construire_interface_chat()
        self.afficher_systeme("Connecté au serveur !")

    def _echec_connexion(self, msg):
        messagebox.showerror(APP_NAME, msg)
        self._ecran_demarrage()

