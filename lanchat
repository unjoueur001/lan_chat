            nom = s["nom"]
            btn = tk.Button(self.liste_salons_frame, text=f"# {nom}", font=(FONT, 9), anchor="w",
                            bg=C_SURF2 if nom == self.salon_courant else C_BG2,
                            fg=C_BLUE if nom == self.salon_courant else C_TEXT,
                            relief="flat", command=lambda n=nom: self._changer_salon(n))
            btn.pack(fill="x", pady=1, padx=2)

    def _changer_salon(self, nom):
        self.salon_courant = nom
        self.lbl_salon_courant.config(text=f"#{nom}")
        self._rafraichir_liste_salons()

    def _creer_salon(self):
        nom = simpledialog.askstring("Nouveau Salon", "Nom du salon :", parent=self.root)
        if nom:
            nom = nom.strip().lower().replace(" ", "-")
            if not any(s["nom"] == nom for s in self.salons):
                data = make_msg("salon_cree", nom=nom, type_salon="texte", desc="")
                if self.mode == "host":
                    self.salons.append({"nom": nom, "type": "texte", "desc": ""})
                    self._rafraichir_liste_salons()
                    self._diffuser(data)
                elif self.sock:
                    try: self.sock.sendall(data)
                    except OSError: pass

    def _on_salon_cree(self, nom, typ, desc):
        if not any(s["nom"] == nom for s in self.salons):
            self.salons.append({"nom": nom, "type": typ, "desc": desc})
            self._rafraichir_liste_salons()

    def _init_salons(self, salons):
        if salons:
            self.salons = salons
            self._rafraichir_liste_salons()

    def _ouvrir_popover_emojis(self):
